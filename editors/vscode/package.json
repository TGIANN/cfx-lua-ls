{
  "name": "cfx-lua-ls",
  "displayName": "CfxLua Language Server",
  "description": "Lua language server and linter for FiveM: fxmanifest sides, natives, exports, events, ox_lib, QBCore, Qbox and ESX. Fast and light, written in Rust.",
  "version": "1.4.0",
  "publisher": "tgiann",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  },
  "homepage": "https://github.com/TGIANN/cfx-lua-ls#readme",
  "bugs": {
    "url": "https://github.com/TGIANN/cfx-lua-ls/issues"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/TGIANN/cfx-lua-ls"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "lua",
    "fivem",
    "cfxlua",
    "cfx",
    "redm",
    "fxmanifest",
    "ox_lib",
    "qbcore",
    "qbox",
    "esx",
    "linter",
    "language server"
  ],
  "activationEvents": [
    "onLanguage:lua"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "cfxLuaLs.server.path"
      ],
      "description": "The server path comes only from user settings."
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "CfxLua Language Server",
      "properties": {
        "cfxLuaLs.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the `cfx-lua-ls` executable. Empty: the one shipped with the extension, else `cfx-lua-ls` from an absolute `PATH` folder. Only user settings count: a workspace cannot choose the program that runs."
        },
        "cfxLuaLs.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the server to the output channel."
        },
        "Lua.spell.dict": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Words `spell-check` accepts besides its dictionaries (the same key as lua-language-server). The spell-check quick fix adds words here."
        },
        "Lua.nameStyle.config": {
          "type": "object",
          "default": {},
          "markdownDescription": "Rules for `name-style-check`, with EmmyLuaCodeStyle's keys (`local_name_style`, `function_name_style`, ...), the same key as lua-language-server."
        }
      }
    },
    "commands": [
      {
        "command": "cfxLuaLs.restartServer",
        "title": "Restart Language Server",
        "category": "CfxLua"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.91.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
